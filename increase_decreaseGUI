import tkinter as tk
from tkinter import messagebox

class CounterGUI:
    def __init__(self):
        self.root = tk.Tk()
        
        screen_width = self.root.winfo_screenwidth()
        screen_height = self.root.winfo_screenheight()

        window_width = 500
        window_height = 200

        position_x = (screen_width // 2) - (window_width // 2)
        position_y = (screen_height // 2) - (window_height // 2)

        self.root.geometry(f"{window_width}x{window_height}+{position_x}+{position_y}")

        self.number = 0

        self.label = tk.Label(self.root, text=self.number, font=('Arial', 25))
        self.label.pack(padx=10,pady=10)
#-------------------------- To add the number modificator -----------------------------------
        self.numberFrame = tk.Frame(self.root)
        self.numberFrame.columnconfigure(0,weight=1)
        self.numberFrame.columnconfigure(1,weight=1)
        self.numberFrame.columnconfigure(2,weight=1)

        btn1 = tk.Button(self.numberFrame, text="+", font=('Arial', 18),command=self.increase)
        btn1.grid(row=0, column=0, sticky=tk.W+tk.E)
        btn2 = tk.Button(self.numberFrame, text="-", font=('Arial', 18),command=self.decrease)
        btn2.grid(row=0, column=1, sticky=tk.W+tk.E)
        btn3 = tk.Button(self.numberFrame, text="Reset", font=('Arial', 18),command=self.reset)
        btn3.grid(row=0, column=2, sticky=tk.W+tk.E)

        self.numberFrame.pack(fill='x')

        self.root.title("NumberDI App")
        self.root.mainloop()

    def increase(self):
        self.number += 1
        self.label.config(text=self.number)  # update label


    def decrease(self):
        self.number -= 1
        self.label.config(text=self.number)  # update label

    def reset(self):
        self.number = 0
        self.label.config(text=self.number)  # update label

CounterGUI()
